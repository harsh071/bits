# Copy to .env and fill in what you have. Everything is optional except one model provider.

# --- Model (pick one) ---
# BITS_MODEL=anthropic:claude-sonnet-5-5
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Local models via Ollama / LM Studio (OpenAI-compatible):
# BITS_MODEL=local:qwen3:14b
# BITS_LOCAL_BASE_URL=http://localhost:11434/v1

# Cheap model for summaries + auto-review (defaults to the main model)
# BITS_FAST_MODEL=anthropic:claude-haiku-5-5

# --- Voice (falls back to the browser's built-in speech if unset) ---
# BITS_STT=openai        # openai | browser
# BITS_TTS=openai        # openai | cartesia | browser
# CARTESIA_API_KEY=
# CARTESIA_VOICE_ID=

# --- Web search (falls back to DuckDuckGo HTML) ---
# TAVILY_API_KEY=
# BRAVE_API_KEY=

# --- Daemon ---
# BITS_HOME=~/.bits
# BITS_PORT=7077

{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile --filter @bits/site... --filter @bits/web...",
  "buildCommand": "pnpm --filter @bits/site build:launch",
  "outputDirectory": "apps/site/dist",
  "rewrites": [{ "source": "/demo/:path*", "destination": "/demo/index.html" }],
  "headers": [
    {
      "source": "/(assets|demo/assets)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
